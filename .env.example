# Supabase — copiá este archivo a .env.local y completá los valores.
# Se obtienen en: Supabase → Project Settings → Data API / API keys

# URL del proyecto (ej. https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (segura para el navegador; RLS controla el acceso)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" (solo servidor, nunca importar en código del cliente).
# Se reserva para tareas puntuales de setup/seed; el admin opera con sesión de usuario.
SUPABASE_SERVICE_ROLE_KEY=
